NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/gitts_education
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false

# Registration/referral configuration
REGISTRATION_FEE=300
DIRECT_REFERRAL_COMMISSION=50
SECOND_LEVEL_COMMISSION=30
MIN_WITHDRAWAL=100

# Safaricom Daraja. Use sandbox first, then production credentials.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL_NUMBER=1745713
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CALLBACK_URL=https://YOUR-DOMAIN.example/api/payments/mpesa/callback

# Email password-reset delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GITTS-Education <no-reply@example.com>

# Optional Cloudinary file storage. Configure for persistent uploads in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial admin creation; run npm run seed:admin after configuring these.
ADMIN_NAME=GITTS Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
